  /* ── CONTACT ── */
  #contact { background: var(--slate-dk); }
  #contact .section-label { color: var(--terra); }
  #contact .section-label::before { background: var(--terra); }
  #contact .section-h2 { color: #fff; }
  #contact .section-h2 em { color: var(--terra); }
  #contact .section-sub { color: rgba(255,255,255,.72); }

  .contact-layout {
