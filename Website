    border: none;
    cursor: pointer;
  }
  .btn-primary:hover { background: var(--terra-lt); transform: translateY(-1px); }

  .btn-ghost {
    display: inline-block;
    padding: 13px 30px;
    background: transparent;
    color: var(--slate-dk);
    text-decoration: none;
    font-size: 1rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-weight: 500;
    border-radius: 2px;
    border: 1px solid var(--slate);
    transition: border-color .2s, color .2s, transform .15s;
    cursor: pointer;
  }
  .btn-ghost:hover { border-color: var(--terra); color: var(--terra); transform: translateY(-1px); }

  .hero-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 24px;
  }

  .hero-logo-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 32px 40px;
    border: 1px solid var(--border);
    background: #fff;
    max-width: 100%;
    position: relative;
  }
  .hero-logo-block::before { display: none; }
  .hero-logo-block svg { width: 90px; height: auto; }
  .hero-logo-block .logo-name {
    font-family: var(--ff-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: .08em;
    color: var(--slate-dk);
  }
  .hero-logo-block .logo-tag {
    font-size: .92rem;
    letter-spacing: .2em;
    color: var(--terra);
    text-transform: uppercase;
  }

  .hero-badges {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .hero-badge {
    padding: 8px 16px;
    border: 1px solid var(--border);
    font-size: .92rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    background: #fff;
    font-weight: 400;
  }

  /* ── SECTION SHARED ── */
  section { padding: var(--section-pad) 0; }
  .inner { max-width: var(--max-w); margin: 0 auto; padding-left: clamp(20px, 5vw, 60px); padding-right: clamp(20px, 5vw, 60px); }

  .section-label {
    font-size: .92rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--terra);
    font-weight: 500;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .section-label::before {
    content: '';
    display: block;
    width: 28px;
    height: 1px;
    background: var(--terra);
  }

  .section-h2 {
    font-family: var(--ff-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 300;
    color: var(--slate-dk);
    line-height: 1.12;
    letter-spacing: -.01em;
  }
  .section-h2 em { font-style: italic; color: var(--terra); }

  .section-sub {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
    font-weight: 300;
    max-width: 560px;
    margin-top: 16px;
  }

  /* ── DIVIDER ── */
  .divider {
    height: 1px;
    background: var(--border);
    max-width: var(--max-w);
    margin: 0 auto;
  }

  /* ── ABOUT ── */
  #about { background: var(--cream); }
  .about-owner { display: grid; grid-template-columns: minmax(0, 560px) 1fr; gap: 60px; align-items: start; margin-top: 48px; }
  
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-top: 52px;
  }
  .about-text p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.85;
    font-weight: 300;
    margin-bottom: 20px;
  }
  .about-text p:last-child { margin-bottom: 0; }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--border);
  }
  .stat {
    background: #fff;
    padding: 32px 28px;
    text-align: left;
  }
  .stat-num {
    font-family: var(--ff-display);
    font-size: 3rem;
    font-weight: 300;
    color: var(--slate-dk);
    line-height: 1;
    margin-bottom: 8px;
  }
  .stat-num span { color: var(--terra); }
  .stat-label {
    font-size: 1.05rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  /* ── SERVICES ── */
  #services { background: var(--slate-dk); }
  #services .section-label { color: var(--terra); }
  #services .section-label::before { background: var(--terra); }
  #services .section-h2 { color: #fff; }
  #services .section-h2 em { color: var(--terra); }
  #services .section-sub { color: rgba(255,255,255,.5); }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2px;
    margin-top: 52px;
    background: rgba(255,255,255,.06);
  }

  .service-card {
    background: var(--slate-dk);
    padding: clamp(24px, 3vw, 36px) clamp(20px, 2.5vw, 32px);
    position: relative;
    cursor: default;
    transition: background .25s;
    border-top: 2px solid transparent;
  }
  .service-card:hover {
    background: rgba(255,255,255,.04);
    border-top-color: var(--terra);
  }
  .service-icon {
    width: 44px;
    height: 44px;
    margin-bottom: 20px;
    color: var(--terra);
    opacity: .9;
  }
  .service-name {
    font-family: var(--ff-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: #fff;
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .service-desc {
    font-size: .92rem;
    color: rgba(255,255,255,.72);
    line-height: 1.7;
    font-weight: 300;
  }
  .service-card::after { display: none; }
  

  /* ── WHY ── */
  #why { background: #fff; }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    margin-top: 52px;
  }
  .why-list { list-style: none; display: flex; flex-direction: column; gap: 0; }
  .why-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .why-item:last-child { border-bottom: none; }
  .why-num {
    font-family: var(--ff-display);
    font-size: 2rem;
    font-weight: 300;
    color: var(--border);
    line-height: 1;
    flex-shrink: 0;
    width: 40px;
    padding-top: 2px;
  }
  .why-content {}
  .why-title {
    font-family: var(--ff-display);
    font-size: 1.15rem;
    color: var(--slate-dk);
    margin-bottom: 6px;
  }
  .why-text { font-size: 1.05rem; color: var(--muted); line-height: 1.75; font-weight: 300; }
  .why-bullets { margin: 10px 0 0 16px; padding: 0; font-size: .92rem; color: var(--muted); line-height: 1.7; font-weight: 300; }
  .why-bullets li { margin-bottom: 5px; }

  .why-callout {
    background: var(--cream);
    padding: clamp(28px, 5vw, 48px) clamp(20px, 4vw, 40px);
    border-left: 3px solid var(--terra);
    position: relative;
  }
  .why-callout blockquote {
    font-family: var(--ff-display);
    font-size: 1.75rem;
    font-weight: 300;
    font-style: italic;
    color: var(--slate-dk);
    line-height: 1.45;
    margin-bottom: 28px;
  }
  .why-callout-sub {
    font-size: .88rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--terra);
    font-weight: 500;
  }

  /* ── GALLERY PLACEHOLDER ── */
  #gallery { background: var(--cream); }
  .gallery-note {
    margin-top: 20px;
    font-size: 1rem;
    color: var(--muted);
    font-style: italic;
  }
  .gallery-grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 3px;
  }
  .gallery-cell {
    background: var(--slate);
    aspect-ratio: 4/3;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-cell:first-child {
    grid-row: span 2;
    aspect-ratio: auto;
  }
  .gallery-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,.25);
  }
  .gallery-placeholder svg { width: 32px; height: 32px; }
  .gallery-placeholder span { font-size: .92rem; letter-spacing: .1em; text-transform: uppercase; }

  .gallery-cta {
    margin-top: 36px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
